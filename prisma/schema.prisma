generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  OFFICER
}

enum OfficerDecision {
  APPROVED
  REJECTED
  PENDING
}

enum ClearanceType {
  FEE_CLEARANCE
  APPLICATION_LETTER
  STATEMENT_OF_RESULT
  SECURITY_CLEARANCE
  ACCOMMODATION_CLEARANCE
  LIBRARY_CLEARANCE
}

enum ClearanceStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  REJECTED
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Student {
  id            String  @id @default(cuid())
  fullName      String
  regNo         String  @unique
  email         String?
  department    String
  level         String
  phoneNumber   String?
  programme     String?
  stateOfOrigin String?

  clearances  Clearance[]
  certificate ClearanceCertificate?

  createdAt DateTime @default(now())
}

model Clearance {
  id String @id @default(cuid())

  studentId String
  type      ClearanceType

  status   ClearanceStatus @default(NOT_STARTED)
  progress Int             @default(0)

  student Student @relation(fields: [studentId], references: [id])

  steps     ClearanceStep[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, type])
}

model ClearanceStep {
  id String @id @default(cuid())

  clearanceId String
  title       String

  status StepStatus @default(PENDING)

  aiVerified Boolean @default(false)
  aiScore    Float?
  aiComment  String?

  reviewedBy String?
  reviewedAt DateTime?

  clearance Clearance @relation(fields: [clearanceId], references: [id])
}

model ClearanceCertificate {
  id String @id @default(cuid())

  studentId String @unique

  verificationCode String @unique

  qrCodeUrl String?

  issuedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
}

model Document {
  id String @id @default(cuid())

  clearanceId String
  type        String
  fileUrl     String

  detectedType String?

  extractedText String? @db.Text

  status DocumentStatus @default(PENDING)

  aiVerified Boolean @default(false)
  aiScore    Float?
  aiComment  String?

  officerDecision OfficerDecision?
  officerComment  String?
  reviewedAt      DateTime?

  uploadedAt DateTime @default(now())

  clearance Clearance @relation(fields: [clearanceId], references: [id])
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  role Role

  createdAt DateTime @default(now())
}

model Notification {
  id      String  @id @default(cuid())
  userId  String
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())
}
